# StyleFlow 运行配置示例
#
# 通常不需要手工创建：直接运行 `python start.py`（或双击 start.bat），
# 启动脚本会自动生成并维护根目录的 .env 文件。
# 只有需要自定义时，才把本文件复制为 .env 并按需修改。

# ---------------- 基础 ----------------
DJANGO_SETTINGS_MODULE=config.settings.local
# 留空或保持 change-me 时，启动脚本会自动生成随机密钥
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# API Key 独立加密密钥（与 SECRET_KEY 不同），留空时启动脚本自动生成
API_KEY_ENCRYPTION_KEY=
DJANGO_DEBUG=true

# ---------------- 端口 ----------------
# 前端是唯一对外开放的端口；后端（含 Django 管理后台 /admin/）一般只在本机/内网访问
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---------------- 数据库 ----------------
# sqlite：零配置，数据文件在 data/styleflow.sqlite3（默认，推荐新手）
# postgres：沿用下面的 DB_* 配置
DATABASE_MODE=sqlite
# 自定义 SQLite 文件位置（可选）
SQLITE_PATH=
# PostgreSQL 连接信息（DATABASE_MODE=postgres 时生效）
DB_NAME=styleflow
DB_USER=styleflow
DB_PASSWORD=styleflow
DB_HOST=localhost
DB_PORT=5432

# ---------------- 后台任务 ----------------
# thread：进程内线程池，无需 Redis（默认）
# celery：需要 Redis，适合多机/高并发场景
TASK_BACKEND=thread
LOCAL_TASK_WORKERS=2
# TASK_BACKEND=celery 时使用
REDIS_URL=redis://localhost:6379/0

# ---------------- 文件存储 ----------------
# local：本地磁盘 data/media（默认）
# s3：S3 / MinIO / 阿里云 OSS 兼容存储
STORAGE_BACKEND=local
# 重要：留空表示图片使用「同源相对路径」（局域网/域名访问必须留空）
# 只有在单独部署后端并需要绝对地址时才填写，例如 http://192.168.1.5:8000
BACKEND_BASE_URL=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=styleflow
MINIO_ENDPOINT=http://localhost:9000

# ---------------- 公网 / 反向代理（可选）----------------
# 用域名访问时填写，例如 https://styleflow.example.com
CSRF_TRUSTED_ORIGINS=
# 反向代理已配置 HTTPS 后可打开以下三项
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# ---------------- AI 服务（可选）----------------
# 不填也能正常运行系统，只是「AI 生成 / 虚拟试衣」等能力不可用
OPENAI_API_KEY=
CLAUDE_API_KEY=
TONGYI_API_KEY=
# 本地 Stable Diffusion WebUI 地址（需自行部署）
SD_WEBUI_URL=http://localhost:7860

# ---------------- ERP 对接（可选）----------------
ERP_MODE=direct
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_HOST=
ERP_DB_PORT=

# ---------------- 其他 ----------------
LOG_LEVEL=INFO
# 数据目录（默认 <项目根>/data，存放数据库、图片、日志）
STYLEFLOW_DATA_DIR=
