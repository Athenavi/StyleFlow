# .env.example - copy to .env and fill in values
#
# 注意：一键运行时请使用「项目根目录」的 .env（由 start.py 自动生成与维护），
# 本文件仅供手工部署 / 参考使用。
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# API Key 独立加密密钥（与 SECRET_KEY 不同）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ENCRYPTION_KEY=
DJANGO_SETTINGS_MODULE=config.settings.local

# sqlite（零配置，默认）| postgres
DATABASE_MODE=sqlite
DB_NAME=styleflow
DB_USER=styleflow
DB_PASSWORD=styleflow
DB_HOST=localhost
DB_PORT=5432

# thread（进程内线程池，无需 Redis）| celery
TASK_BACKEND=thread
REDIS_URL=redis://localhost:6379/0

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=styleflow
MINIO_ENDPOINT=http://localhost:9000

OPENAI_API_KEY=
CLAUDE_API_KEY=
TONGYI_API_KEY=
SD_WEBUI_URL=http://localhost:7860

ERP_MODE=direct
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_HOST=
ERP_DB_PORT=

# 文件存储: local（本地 data/media）| s3（MinIO/OSS 兼容）
STORAGE_BACKEND=local
# 后端地址（用于生成文件访问 URL）。
# 重要：留空表示使用「同源相对路径 /media/...」，局域网 / 域名访问必须留空！
# 仅在前后端分开部署且后端有独立公网地址时才填写，例如 http://192.168.1.5:8000
BACKEND_BASE_URL=
